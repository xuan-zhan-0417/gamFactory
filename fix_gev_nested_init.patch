-    .backfit_si_initialize(y = y, nobs = nobs, E = E, x = x, family = family, offset = offset,
-                            weights = weights, info = info, n_init = n_init_use, n_eigen = si_init$n_eigen,
+    # the reduced designs used for the initialisation contain only standard effects, so the bundle
+    # initialisation gets the standard family (gevlss()$initialize, for instance, calls family$ll)
+    .backfit_si_initialize(y = y, nobs = nobs, E = E, x = x, family = family, family_std = build_family(bundle, link = Links)(),
+                            offset = offset, weights = weights, info = info, n_init = n_init_use, n_eigen = si_init$n_eigen,
                             oversample = si_init$oversample, seed = si_init$seed)
 
   }
