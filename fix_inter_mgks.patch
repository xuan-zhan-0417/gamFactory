         ipc <- 2:eff[[ii]]$na
       }
         pen[[kk]] <- pen_ridge_var(o = eff[[ii]], extra = extra, ipc = ipc, deriv = deriv)
+        if( effType[ii] == "inter_mgksnested" ){
+          # The log-likelihood grows with n but lamRidge does not. For the kernel bandwidths this leaves the
+          # objective flat once the kernel degenerates to nearest-neighbour (bandwidths -> Inf), and one early
+          # Newton step can land there. Multiply lamRidge by n: negligible at the optimum (curvature >> n),
+          # but it blocks that jump. Used as lamRidge * pen$w in build_family_nl.
+          pen[[kk]]$w <- nrow(extra$si$dist[[1]])
+        }
     }
     
     pen[[kk]]$iec <- aii 
